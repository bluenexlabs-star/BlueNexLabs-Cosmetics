# Local on your PC (SQLite file). Leave this as-is until you deploy.
DATABASE_URL="file:./dev.db"

# On Vercel / when using Supabase, replace the SQLite line with BOTH of these.
# Prisma tab in Supabase → copy Transaction pooler (6543) and Direct/Session (5432).
# DATABASE_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"
#
# If Vercel’s Supabase integration is used, these names also work:
# POSTGRES_PRISMA_URL / POSTGRES_URL  → used as DATABASE_URL
# POSTGRES_URL_NON_POOLING            → used as DIRECT_URL

SESSION_SECRET="change-me-to-a-32-character-secret"
ADMIN_EMAIL="admin@bluenexlabs.com"
ADMIN_PASSWORD="change-me"
REQUIRE_CUSTOMER_ACCOUNT="false"
INTERAC_EMAIL="BlueNexLabs@gmail.com"
NEXT_PUBLIC_SITE_URL="http://localhost:43123"
